<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">

	<name>COM_SHUTTLE</name>
	<author>Jonatas C. Ferreira</author>
	<creationDate>April 2026</creationDate>
	<authorEmail>jonatas@tabaoca.org</authorEmail>
	<authorUrl>https://tabaoca.org</authorUrl>
	<copyright>Copyright (C) 2026 Jonatas C. Ferreira. All rights reserved.</copyright>
	<license>GNU/AGPL v3 https://www.gnu.org/licenses/agpl-3.0.html</license>
	<version>2.0.4</version>
	<description>COM_SHUTTLE_DESCRIPTION</description>
	<element>com_shuttle</element>

	<namespace path="src">Tabaoca\Component\Shuttle</namespace>

	<files folder="site">
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>

	<languages folder="site/language">
		<language tag="en-GB">en-GB/en-GB.com_shuttle.ini</language>
		<language tag="pt-BR">pt-BR/pt-BR.com_shuttle.ini</language>
	</languages>

	<media folder="media" destination="com_shuttle">
 		<folder>js</folder>
		<filename>joomla.asset.json</filename>
	</media>

	<administration>

		<menu link="option=com_shuttle&amp;view=shuttle" img="class:comments-2">COM_SHUTTLE</menu>

		<files folder="admin">
			<file>access.xml</file>
			<file>config.xml</file>
			<folder>services</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>

		<languages folder="admin/language">
			<language tag="en-GB">en-GB/en-GB.com_shuttle.ini</language>
			<language tag="en-GB">en-GB/en-GB.com_shuttle.sys.ini</language>
			<language tag="pt-BR">pt-BR/pt-BR.com_shuttle.ini</language>
			<language tag="pt-BR">pt-BR/pt-BR.com_shuttle.sys.ini</language>
		</languages>

	</administration>

</extension>
